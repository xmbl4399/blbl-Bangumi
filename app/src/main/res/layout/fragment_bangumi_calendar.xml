<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/blblPageBackdrop"
    android:orientation="vertical">

    <!-- 年份切换栏(单排,如 2026 2025 ...;最新在前)
         DividedTabLayout:相邻年份画低透明度分隔线 + 选中项盖低透明度强调色块
         (纯 draw,不占宽度 ⇒ 可见年份数量与密度不变) -->
    <blbl.cat3399.core.ui.DividedTabLayout
        android:id="@+id/tab_quarter"
        style="@style/Widget.Blbl.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:focusable="false"
        app:tabIndicatorFullWidth="true"
        app:tabMode="scrollable"
        app:tabMinWidth="0dp"
        app:tabPaddingStart="8dp"
        app:tabPaddingEnd="8dp"
        app:tabSelectedTextColor="?attr/blblAccent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/blblContentBackground">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:padding="8dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无数据，下拉刷新重试"
        android:textColor="?attr/blblOnPageBackdropSecondary"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
